# ==============================================================================
# Git Ignore Configuration for BookStop Bookstore Application
# ==============================================================================

# Dependencies
node_modules/
Frontend/node_modules/
backend/node_modules/
*/node_modules/

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
Frontend/.env
Frontend/.env.local
Frontend/.env.production

# Keep example templates safe
!.env.example
!backend/.env.example
!Frontend/.env.example

# Build outputs
dist/
Frontend/dist/
build/
Frontend/build/
.vite/
Frontend/.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data & temp files
test-e2e-flow.js
Frontend/test-e2e-flow.js
coverage/
.nyc_output/

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
